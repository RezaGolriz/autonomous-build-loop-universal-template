<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps the build-loop control page running for one project on macOS.
  Replace every placeholder before installing:
    <TEMPLATE_ROOT>  absolute path of this build-loop checkout or package
    <PROJECT_ROOT>   absolute path of the project the page shows
    <NODE>           absolute path of node 22 or newer (see: command -v node)
  Install and remove it as described in docs/CONFIGURATION.md
  ("Keep the control page running"). The access link is printed by
  build-loop serve --root <PROJECT_ROOT> --show-link; it never appears here.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.build-loop.control-page</string>
  <key>ProgramArguments</key>
  <array>
    <string><NODE></string>
    <string><TEMPLATE_ROOT>/control/control-page-server.mjs</string>
    <string><PROJECT_ROOT></string>
  </array>
  <key>WorkingDirectory</key>
  <string><PROJECT_ROOT></string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardErrorPath</key>
  <string><PROJECT_ROOT>/.loop/scheduler/control-page.log</string>
  <key>StandardOutPath</key>
  <string><PROJECT_ROOT>/.loop/scheduler/control-page.log</string>
</dict>
</plist>
