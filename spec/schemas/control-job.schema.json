{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autonomous-build-loop/control-job.schema.json",
  "title": "Detached control job v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "request_id", "operation", "status", "desired_status", "max_nodes", "nodes_completed", "created_at", "started_at", "finished_at", "pid", "exit_code", "last_error", "lock_id", "work_item_id", "phase_at_launch", "state_at_launch_digest", "activation_digest", "host_config_digest", "bound_config"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "pattern": "^job-[A-Za-z0-9._-]+$"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "operation": {"enum": ["activate", "start", "run", "resume"]},
    "status": {"enum": ["QUEUED", "RUNNING", "STOPPING", "PAUSED", "CANCELLED", "COMPLETED", "FAILED"]},
    "desired_status": {"enum": ["RUNNING", "PAUSED", "CANCELLED"]},
    "max_nodes": {"type": "integer", "minimum": 1, "maximum": 500},
    "nodes_completed": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "pid": {"type": ["integer", "null"], "minimum": 1},
    "exit_code": {"type": ["integer", "null"]},
    "last_error": {"type": ["object", "null"]},
    "lock_id": {"type": "string", "minLength": 32},
    "work_item_id": {"type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "phase_at_launch": {"enum": ["DEFINE", "DESIGN", "EXECUTE", "REVIEW", "VALIDATE", "HANDOVER"]},
    "state_at_launch_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "activation_digest": {"type": "string", "minLength": 1},
    "host_config_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "bound_config": {"type": ["object", "null"]},
    "activation_result": {"type": ["object", "null"]},
    "last_exit_code": {"type": "integer"}
  }
}
