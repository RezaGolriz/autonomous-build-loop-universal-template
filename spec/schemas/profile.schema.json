{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autonomous-build-loop/profile.schema.json",
  "title": "Advisory project-shape profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "project_kind", "suggested_artifact_kinds", "required_validation_evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*-v[0-9]+$"},
    "project_kind": {"enum": ["cli", "api", "library", "docs"]},
    "suggested_artifact_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["executable", "service", "package", "document-set"]}
    },
    "required_validation_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["acceptance", "command", "artifact", "behavior", "contract", "installation", "package", "documentation", "link-check"]}
    }
  }
}
