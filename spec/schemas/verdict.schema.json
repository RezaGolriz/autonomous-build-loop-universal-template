{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autonomous-build-loop/verdict.schema.json",
  "title": "Independent review verdict v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verdict_id", "run_id", "work_item_id", "phase", "gate_id", "nonce", "result", "reviewer", "independent", "revision", "captured_at", "evidence_refs", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "verdict_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "work_item_id": {"type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "phase": {"const": "REVIEW"},
    "gate_id": {"const": "REVIEW"},
    "nonce": {"type": "string", "minLength": 16, "maxLength": 256},
    "result": {"enum": ["PASS", "FAIL"]},
    "reviewer": {"type": "string", "minLength": 1},
    "independent": {"const": true},
    "revision": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "evidence", "disposition"],
        "properties": {
          "severity": {"enum": ["BLOCKING", "HIGH", "MEDIUM", "LOW"]},
          "category": {"enum": ["requirement", "design", "artifact", "safety"]},
          "evidence": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["OPEN", "DISMISSED"]}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
      "then": {
        "properties": {
          "findings": {
            "not": {
              "contains": {
                "type": "object",
                "required": ["severity", "disposition"],
                "properties": {
                  "severity": {"enum": ["BLOCKING", "HIGH"]},
                  "disposition": {"const": "OPEN"}
                }
              }
            }
          }
        }
      }
    }
  ]
}
