{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autonomous-build-loop/project-adapter.schema.json",
  "title": "Project adapter v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_id", "project_kind", "target", "artifacts", "commands", "validation", "protected_paths", "environment"],
  "properties": {
    "schema_version": {"const": 1},
    "adapter_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "project_kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "target": {"$ref": "#/$defs/target"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/command"}},
    "validation": {"$ref": "#/$defs/validation"},
    "protected_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}},
    "environment": {"$ref": "#/$defs/environment"}
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "runtimes", "platforms"],
      "properties": {
        "languages": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "runtimes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "paths"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "cwd", "argv", "timeout_seconds", "evidence_types"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "phase": {"enum": ["EXECUTE", "VALIDATE"]},
        "cwd": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "evidence_types": {
          "type": "array", "minItems": 1, "uniqueItems": true, "contains": {"const": "command"},
          "items": {"enum": ["acceptance", "command", "artifact", "behavior", "contract", "installation", "package", "documentation", "link-check"]}
        }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false, "required": ["allow_names"],
      "properties": {"allow_names": {"type": "array", "minItems": 1, "uniqueItems": true, "contains": {"const": "PATH"}, "items": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"}}}
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_evidence"],
      "properties": {
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["acceptance", "command", "artifact", "behavior", "contract", "installation", "package", "documentation", "link-check"]}
        }
      }
    }
  }
}
